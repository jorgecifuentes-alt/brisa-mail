# Copia este archivo a .env.local y completa tus datos.

# Lectura (IMAP)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=tu@correo.com
IMAP_PASS=contraseña-de-aplicación

# Envío (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu@correo.com
SMTP_PASS=contraseña-de-aplicación
MAIL_FROM="Tu Nombre <tu@correo.com>"
# Gmail guarda solo lo enviado. En otros servidores, actívalo para copiarlo a "Enviados".
SAVE_SENT=false

# IA (resúmenes, mapas mentales, borradores)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Acceso. Sin APP_PASSWORD, Brisa solo se abre desde este mismo computador (localhost).
# Para usarla desde el celular u otro equipo, define una contraseña.
APP_USER=brisa
APP_PASSWORD=

# Notificaciones push. Si no las defines, se generan solas en data/vapid.json.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tu@correo.com

# Otras direcciones tuyas que recibes en esta casilla (alias), separadas por coma.
# Personas agrupa los correos por la dirección que los recibió, como Spark.
# MY_ADDRESSES=jorge.cifuentes@estriba.cl
